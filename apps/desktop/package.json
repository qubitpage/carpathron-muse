{
  "name": "muse-carpathron",
  "productName": "Carpathron Robotics & Coding",
  "version": "1.7.0",
  "description": "Carpathron Robotics & Coding: an AI agent for Windows powered by Meta Muse models. Coding, servers, GitHub, MCP, computer use and robot control.",
  "main": "main.js",
  "author": {
    "name": "Qubitpage LIMITED",
    "email": "contact@qubitpage.com",
    "url": "https://qubitpage.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node backend/standalone.js",
    "test": "node test/run-all.js && node test/v14.js && node test/security.js",
    "dist": "node build/patch-sdk.js && electron-builder --win nsis --x64",
    "postinstall": "node build/patch-sdk.js",
    "test:electron": "xvfb-run -a electron --no-sandbox test/electron-browser.js /tmp",
    "dist:store": "node build/patch-sdk.js && electron-builder --win appx --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server-filesystem": "^2.1.0",
    "@modelcontextprotocol/server-memory": "^2.0.1",
    "@modelcontextprotocol/server-sequential-thinking": "^2.0.0",
    "@muse-code/sdk": "1.4.14",
    "@whiskeysockets/baileys": "6.7.24",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "marked": "18.1.2",
    "ogg-opus-decoder": "1.7.5",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ssh2": "1.16.0",
    "unpdf": "1.9.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "25.1.8",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "ai.carpathron.muse",
    "productName": "Carpathron",
    "copyright": "Copyright © 2026 Qubitpage LIMITED",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "public/guide.md"
    ],
    "asarUnpack": [],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "executableName": "Carpathron"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Carpathron Robotics & Coding",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Carpathron-Robotics-Coding-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Carpathron Robotics & Coding"
    },
    "publish": null,
    "compression": "maximum",
    "appx": {
      "applicationId": "CarpathronRoboticsCoding",
      "identityName": "QubitpageLIMITED.CarpathronRoboticsCoding",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Qubitpage LIMITED",
      "displayName": "Carpathron Robotics & Coding",
      "backgroundColor": "#0d0f12",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "showNameOnTiles": true,
      "customExtensionsPath": "build/appx/extensions.xml",
      "artifactName": "Carpathron-Robotics-Coding-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carpathron/muse-carpathron"
  },
  "homepage": "https://qubitpage.com/projects/carpathron-muse"
}
