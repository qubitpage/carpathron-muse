{
  "name": "muse-carpathron",
  "productName": "Muse Carpathron",
  "version": "1.5.4",
  "description": "Agentic desktop assistant for Meta Muse models: full PC and SSH server access, documents and PDFs, web research, firmware, robot control and WhatsApp remote.",
  "main": "main.js",
  "author": "Carpathron",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node backend/standalone.js",
    "test": "node test/run-all.js && node test/v14.js",
    "dist": "node build/patch-sdk.js && electron-builder --win nsis --x64",
    "postinstall": "node build/patch-sdk.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server-filesystem": "^2.1.0",
    "@modelcontextprotocol/server-memory": "^2.0.1",
    "@modelcontextprotocol/server-sequential-thinking": "^2.0.0",
    "@muse-code/sdk": "1.4.14",
    "@whiskeysockets/baileys": "6.7.24",
    "dompurify": "3.4.17",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "marked": "18.1.2",
    "ogg-opus-decoder": "1.7.5",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ssh2": "1.16.0",
    "unpdf": "1.9.1",
    "ws": "8.18.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "25.1.8",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "ai.carpathron.muse",
    "productName": "Muse Carpathron",
    "copyright": "Copyright 2026 Carpathron",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "public/guide.md"
    ],
    "asarUnpack": [],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Muse Carpathron",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Muse-Carpathron-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carpathron/muse-carpathron"
  }
}
